# Copy file nay thanh .env roi sua gia tri that. .env da nam trong .gitignore.

# Bat buoc. Toi thieu 32 ky tu - jjwt tu choi key ngan hon voi HS256.
# Tao nhanh: openssl rand -base64 48
JWT_SECRET=

# Postgres superuser (chi dung de khoi tao; moi service co role rieng).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Gui ma xac thuc email (VerifyEmailScreen). De trong neu chua lam toi.
# Gmail phai dung App Password, khong dung mat khau tai khoan.
MAIL_USER=
MAIL_PASSWORD=
