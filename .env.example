# Copy file nay thanh .env roi sua gia tri that. .env da nam trong .gitignore.
# Spring Boot o may dev cung tu doc file .env nay (spring.config.import trong application.properties).

# Bat buoc. Toi thieu 32 ky tu - jjwt tu choi key ngan hon voi HS256.
# Tao nhanh: openssl rand -base64 48
JWT_SECRET=

# Postgres superuser (chi dung de khoi tao; moi service co role rieng).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Gui ma OTP email (quen mat khau / xac minh email). De trong neu chua cau hinh SMTP.
# Cach tao App Password Gmail (khong dung mat khau tai khoan thuong):
#   1. Vao myaccount.google.com -> Security -> bat 2-Step Verification
#   2. Tim "App passwords" -> tao ma 16 ky tu cho Mail -> dien vao MAIL_PASSWORD (bo khoang trang)
MAIL_USER=
MAIL_PASSWORD=

# DEV ONLY: dat thanh true o may dev chua co SMTP de in ma OTP 6 so ra docker logs user-service.
# TUYET DOI de false o moi truong that.
OTP_DEV_LOG=false

# Google OAuth 2.0 (Web Client ID tu Google Cloud Console)
GOOGLE_CLIENT_ID=
