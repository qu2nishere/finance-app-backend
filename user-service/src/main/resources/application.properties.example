spring.application.name=user-service
server.port=${SERVER_PORT:8081}

# --- Database rieng cua user-service ---
# Khong service nao duoc doc bang cua service khac. Muon du lieu -> goi API hoac nghe event.
spring.datasource.url=${DB_URL:jdbc:postgresql://localhost:5432/user_db}
spring.datasource.username=${DB_USER:user_db}
spring.datasource.password=${DB_PASSWORD:user_db}

# Flyway so huu schema; Hibernate chi duoc validate, khong tu sua bang.
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.open-in-view=false
spring.flyway.enabled=true

# --- RabbitMQ (giao tiep bat dong bo giua cac service) ---
spring.rabbitmq.host=${RABBITMQ_HOST:localhost}
spring.rabbitmq.port=${RABBITMQ_PORT:5672}
spring.rabbitmq.username=${RABBITMQ_USER:guest}
spring.rabbitmq.password=${RABBITMQ_PASSWORD:guest}
app.events.exchange=finance.events

# --- JWT: user-service phat hanh, gateway/cac service khac chi verify ---
app.jwt.secret=${JWT_SECRET:doi-secret-nay-truoc-khi-deploy-that-toi-thieu-32-ky-tu}
app.jwt.access-token-ttl=15m
app.jwt.refresh-token-ttl=30d

# --- Mail cho VerifyEmailScreen ---
spring.mail.host=${MAIL_HOST:smtp.gmail.com}
spring.mail.port=${MAIL_PORT:587}
spring.mail.username=${MAIL_USER:}
spring.mail.password=${MAIL_PASSWORD:}
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

management.endpoints.web.exposure.include=health,info
